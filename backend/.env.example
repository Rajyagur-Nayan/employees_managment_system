# Database Connection:
# Leave empty to use local zero-configuration SQLite (data/attendance.db).
# Or set your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/attendance_db?sslmode=prefer
DATABASE_URL=

# Camera Sources:
# 0 = Default webcam, 1 = Secondary USB camera, or path to a video file:
CAMERA_SOURCE=0
WORKSTATION_CAMERA_SOURCE=0

# Workstation Presence Settings:
WORKSTATION_ABSENCE_GRACE_SECONDS=60
WORKSTATION_PRESENCE_FRAMES=3
WORKSTATION_DETECTION_INTERVAL=0.2

# Attendance Verification Settings:
ATTENDANCE_CONFIRMATION_FRAMES=3
ATTENDANCE_CONFIRMATION_WINDOW_SEC=2.0
DUPLICATE_WINDOW_SECONDS=60

# Liveness / Anti-Spoofing:
LIVENESS_ENABLED=True
LIVENESS_MIN_VARIANCE=10.0

# Timezone:
TIMEZONE_NAME=Asia/Kolkata
